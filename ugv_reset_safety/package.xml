<?xml version="1.0"?>
<package format="2">
  <name>ugv_reset_safety</name>
  <version>2.0.0</version>
  <description>Coordinated UGV reset: event-driven coordinator, reservation planning with exact swept-footprint verification, no roster.</description>
  <maintainer email="apt@example.com">XGC2</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>ugv_reset_client</depend>
  <depend>ugv_reset_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>roscpp</depend>
  <build_depend>xgc2_geometry_msgs</build_depend>
  <exec_depend>xgc2_geometry_msgs</exec_depend>
  <depend>eigen</depend>
  <build_depend>libxgc2-math-dev</build_depend>
  <build_export_depend>libxgc2-math-dev</build_export_depend>
  <exec_depend>roslaunch</exec_depend>
</package>
