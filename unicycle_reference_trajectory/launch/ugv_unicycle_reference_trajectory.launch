<?xml version='1.0' encoding='utf-8'?>
<launch>
    <arg name="ns" default="ugv1" />
    <arg name="config_file" default="$(find unicycle_reference_trajectory)/config/unicycle_reference_trajectory.yaml" />
    <group ns="$(arg ns)">
        <node pkg="unicycle_reference_trajectory" type="unicycle_reference_trajectory_node" name="unicycle_reference_trajectory" output="screen" clear_params="true">
            <rosparam command="load" file="$(arg config_file)" />
        </node>
    </group>
</launch>
