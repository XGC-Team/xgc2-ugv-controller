<launch>
  <param name="/use_sim_time" value="false"/>
  <!-- The shipped configuration, loaded by the shipped launch composition. -->
  <include file="$(find unicycle_reference_trajectory)/launch/ugv_unicycle_reference_trajectory.launch">
    <arg name="ns" value="ref_test"/>
  </include>
  <!-- The same node with the default analytic request enabled. -->
  <group ns="ref_default">
    <node pkg="unicycle_reference_trajectory" type="unicycle_reference_trajectory_node"
          name="unicycle_reference_trajectory" output="screen" clear_params="true">
      <rosparam command="load"
                file="$(find unicycle_reference_trajectory)/config/unicycle_reference_trajectory.yaml"/>
      <param name="default_analytic/enabled" value="true"/>
      <param name="default_analytic/trajectory_id" value="9"/>
      <param name="default_analytic/revision" value="4"/>
      <param name="default_analytic/start_delay" value="0.3"/>
    </node>
  </group>
  <test test-name="unicycle_reference_trajectory_node_test" pkg="unicycle_reference_trajectory"
        type="unicycle_reference_trajectory_node_test" time-limit="60.0"/>
</launch>
