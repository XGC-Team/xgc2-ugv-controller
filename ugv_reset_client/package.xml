<?xml version="1.0"?>
<package format="2">
  <name>ugv_reset_client</name>
  <version>1.0.0</version>
  <description>The vehicle side of the UGV Reset protocol: the request/response lease of one vehicle and its ROS client. No coordination logic, no other vehicle.</description>
  <maintainer email="apt@example.com">XGC2</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <!-- The ResetRequest/ResetResponse messages stay with the coordinator until the
       cross-product messages move to the shared message repository. -->
  <depend>roscpp</depend>
  <depend>ugv_reset_safety</depend>
  <test_depend>gtest</test_depend>
</package>
