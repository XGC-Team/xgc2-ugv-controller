<?xml version='1.0' encoding='utf-8'?>
<launch>
    <arg name="ns" default="ugv1" />
    <arg name="config_file" default="$(find mecanum_ugv_controller)/config/mecanum_ugv_controller.yaml" />
    <group ns="$(arg ns)">
        <node pkg="mecanum_ugv_controller" type="mecanum_ugv_controller_node" name="mecanum_ugv_controller" output="screen">
            <rosparam command="load" file="$(arg config_file)" />
        </node>
    </group>
</launch>
