<launch>
  <!-- Isolated rostest master only. The Scout of reset_coordinator_scout.test as the module entity of
       ugv_modules (the generator, the controller and the ROS edge in one xgc2-module-host process)
       in place of the controller node. -->
  <arg name="host" default="$(optenv XGC2_MODULE_HOST)"/>
  <env name="XGC2_MODULE_HOST" value="$(arg host)"/>
  <node pkg="ugv_reset_safety" type="ugv_reset_coordinator_node" name="xgc_reset_coordinator" output="screen"
        required="true">
    <env name="XGC_RESET_EXPECTED_SCOPE" value="[{&quot;kind&quot;:&quot;scout_mini&quot;,&quot;namespace&quot;:&quot;ugv1&quot;}]"/>

    <env name="XGC_RESET_SCENE_NAMESPACE" value="/reset_fixture/scene"/>
  </node>
  <node pkg="ugv_integration_tests" type="module_host_node.py" name="scout_entity"
        output="screen" required="true"
        args="$(find ugv_modules)/manifests/scout_unicycle.toml
              edge.config.namespace=ugv1
              edge.config.state_source=platform_pose
              controller.config.state_source=platform_pose
              controller.config.fence.x_min=-6.0
              controller.config.fence.x_max=6.0
              controller.config.fence.y_min=-6.0
              controller.config.fence.y_max=6.0"/>
  <test test-name="reset_protocol_scout_module" pkg="ugv_integration_tests" type="reset_rostest.py"
        time-limit="260.0">
    <param name="scenario" value="scout_scene"/>
  </test>
</launch>
