<launch>
  <!-- Isolated rostest master only. One coordinator with an authored Scene, one Scout controller node. -->
  <node pkg="ugv_reset_safety" type="ugv_reset_coordinator_node" name="xgc_reset_coordinator" output="screen"
        required="true">
    <env name="XGC_RESET_EXPECTED_SCOPE" value="[{&quot;kind&quot;:&quot;scout_mini&quot;,&quot;namespace&quot;:&quot;ugv1&quot;}]"/>

    <env name="XGC_RESET_SCENE_NAMESPACE" value="/reset_fixture/scene"/>
  </node>
  <group ns="ugv1">
    <node pkg="unicycle_ugv_controller" type="unicycle_ugv_controller_node"
          name="unicycle_ugv_controller" output="screen" required="true">
      <rosparam command="load" file="$(find unicycle_ugv_controller)/config/unicycle_ugv_controller.yaml"/>
      <param name="state_source" value="platform_pose"/>
      <param name="fence/x_min" value="-6.0"/>
      <param name="fence/x_max" value="6.0"/>
      <param name="fence/y_min" value="-6.0"/>
      <param name="fence/y_max" value="6.0"/>
    </node>
  </group>
  <test test-name="reset_protocol_scout_scene" pkg="ugv_integration_tests" type="reset_rostest.py"
        time-limit="240.0">
    <param name="scenario" value="scout_scene"/>
  </test>
</launch>
