<launch>
  <!-- Isolated rostest master only: the test program publishes synthetic poses and must never run on
       an experiment or vehicle master. One coordinator without a Scene, one Wheeltec-like vehicle. -->
  <node pkg="ugv_reset_safety" type="ugv_reset_coordinator_node" name="xgc_reset_coordinator" output="screen">
    <env name="XGC_RESET_EXPECTED_SCOPE" value="[{&quot;kind&quot;:&quot;mecanum_ugv&quot;,&quot;namespace&quot;:&quot;ugv1&quot;}]"/>
  </node>
  <group ns="ugv1">
    <node pkg="mecanum_ugv_controller" type="mecanum_ugv_controller_node"
          name="mecanum_ugv_controller" output="screen" required="true">
      <rosparam command="load" file="$(find mecanum_ugv_controller)/config/mecanum_ugv_controller.yaml"/>
      <param name="fence/x_min" value="-6.0"/>
      <param name="fence/x_max" value="6.0"/>
      <param name="fence/y_min" value="-6.0"/>
      <param name="fence/y_max" value="6.0"/>
    </node>
  </group>
  <test test-name="reset_protocol_mecanum_open" pkg="ugv_integration_tests" type="reset_rostest.py"
        time-limit="240.0">
    <param name="scenario" value="mecanum_open"/>
  </test>
</launch>
