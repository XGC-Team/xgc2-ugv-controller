<?xml version="1.0"?>
<package format="2">
  <name>ugv_modules</name>
  <version>1.0.0</version>
  <description>The Scout unicycle chain as xgc2-module modules: the planar reference generator, the NMPC and flatness controller and the ROS1 edge of the vehicle, with the payload header they share and the entity manifests.</description>
  <maintainer email="apt@example.com">XGC2</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>libjsoncpp-dev</build_depend>
  <build_depend>rigid_state_estimator_msgs</build_depend>
  <build_depend>rosgraph_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>ugv_reset_client</build_depend>
  <build_depend>ugv_reset_msgs</build_depend>
  <build_depend>unicycle_reference_trajectory</build_depend>
  <build_depend>unicycle_reference_trajectory_msgs</build_depend>
  <build_depend>unicycle_ugv_controller</build_depend>

  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>rigid_state_estimator_msgs</build_export_depend>
  <build_export_depend>rosgraph_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>ugv_reset_msgs</build_export_depend>
  <build_export_depend>unicycle_reference_trajectory_msgs</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>libjsoncpp1</exec_depend>
  <exec_depend>rigid_state_estimator_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ugv_reset_client</exec_depend>
  <exec_depend>ugv_reset_msgs</exec_depend>
  <exec_depend>unicycle_reference_trajectory</exec_depend>
  <exec_depend>unicycle_reference_trajectory_msgs</exec_depend>
  <exec_depend>unicycle_ugv_controller</exec_depend>

  <test_depend>gtest</test_depend>
  <test_depend>rostest</test_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
